{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DO_NOT_TRACK": "1"
  },
  "disableArtifact": true,
  "permissions": {
    "allow": [
      "Bash(./cks status *)",
      "Bash(./cks up *)",
      "Bash(./cks kubectl *)",
      "Bash(./cks k *)",
      "Bash(./cks node *)",
      "Bash(./cks seed *)",
      "Bash(./cks addon *)",
      "Bash(./cks verify-local *)",
      "Bash(./cks help *)",
      "Bash(./cks selftest *)",
      "Bash(./cks smoke *)"
    ],
    "ask": [
      "Bash(./cks reset *)",
      "Bash(./cks down *)",
      "Bash(./cks purge *)",
      "Edit(/sessions/**/work/**)",
      "WebFetch",
      "WebSearch",
      "Bash(git push *)"
    ],
    "deny": [
      "mcp__*",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.docker/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/containers/**)",
      "Read(~/.netrc)",
      "Read(~/.local/share/containers/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-end.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
