{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "disableArtifact": true,
  "permissions": {
    "allow": [
      "Bash(./cks status *)",
      "Bash(./cks up *)",
      "Bash(./cks kubectl *)",
      "Bash(./cks k *)",
      "Bash(./cks node *)",
      "Bash(./cks seed *)",
      "Bash(./cks addon *)",
      "Bash(./cks verify-local *)",
      "Bash(./cks help *)"
    ],
    "ask": [
      "Bash(./cks reset *)",
      "Bash(./cks down *)",
      "Bash(./cks purge *)",
      "Edit(/sessions/**/work/**)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "mcp__*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh", "timeout": 20 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "prompt_input_exit|logout|other",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-end.sh", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
